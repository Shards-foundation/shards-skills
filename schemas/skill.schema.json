{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shards Skill Metadata",
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "license": {
      "type": "string"
    },
    "compatibility": {
      "type": "string",
      "maxLength": 500
    },
    "metadata": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "verified",
            "deprecated"
          ]
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
